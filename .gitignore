# No versionar los videos grandes de origen.
# El sitio usa YouTube; el único video local publicado es el clip educativo.
videos/*
!videos/visitas_educativas.mp4
!videos/visitas_educativas_poster.jpg

# La carpeta docs/videos la regenera Quarto en cada render;
# solo se publica el clip educativo (el resto son copias pesadas innecesarias).
docs/videos/*
!docs/videos/visitas_educativas.mp4
!docs/videos/visitas_educativas_poster.jpg

# Sistema
.DS_Store
Thumbs.db
.Rproj.user

/.quarto/
**/*.quarto_ipynb
